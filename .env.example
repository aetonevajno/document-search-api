APP_NAME=document-search-api
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=postgresql+asyncpg://document_search:document_search_local@127.0.0.1:5432/document_search
APP_ELASTICSEARCH_URL=http://127.0.0.1:9200
APP_ELASTICSEARCH_INDEX=documents

COMPOSE_BIND_ADDRESS=127.0.0.1
API_PORT=8000
POSTGRES_PORT=5432
ELASTICSEARCH_PORT=9200

POSTGRES_DB=document_search
POSTGRES_TEST_DB=document_search_test
POSTGRES_USER=document_search
POSTGRES_PASSWORD=document_search_local
TEST_DATABASE_URL=postgresql+asyncpg://document_search:document_search_local@127.0.0.1:5432/document_search_test
