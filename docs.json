{
  "components": {
    "schemas": {
      "DocumentResponse": {
        "additionalProperties": false,
        "description": "Document returned by the API",
        "properties": {
          "created_date": {
            "format": "date-time",
            "title": "Created Date",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "rubrics": {
            "items": {
              "type": "string"
            },
            "title": "Rubrics",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "rubrics",
          "text",
          "created_date"
        ],
        "title": "DocumentResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "API error response",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "API health response",
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "document-search-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/documents/search": {
      "get": {
        "description": "Return up to 20 matching documents, newest first",
        "operationId": "search_documents_documents_search_get",
        "parameters": [
          {
            "description": "Non-blank text searched with the Russian analyzer",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Non-blank text searched with the Russian analyzer",
              "minLength": 1,
              "pattern": "\\S",
              "title": "Q",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentResponse"
                  },
                  "title": "Response Search Documents Documents Search Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "PostgreSQL or Elasticsearch is unavailable"
          }
        },
        "summary": "Search documents by text",
        "tags": [
          "documents"
        ]
      }
    },
    "/documents/{document_id}": {
      "delete": {
        "description": "Delete a document from PostgreSQL and Elasticsearch",
        "operationId": "delete_document_documents__document_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Document is absent from both storages"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "PostgreSQL or Elasticsearch is unavailable"
          }
        },
        "summary": "Delete a document",
        "tags": [
          "documents"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Report whether the API process is running",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Check API health",
        "tags": [
          "health"
        ]
      }
    }
  }
}
